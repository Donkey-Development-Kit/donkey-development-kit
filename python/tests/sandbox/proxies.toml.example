# Sandbox proxy manifest — TEMPLATE (safe to commit; NO secrets, only base URLs
# and env-var NAMES). Copy to `proxies.toml` (gitignored) and fill in the real
# base URLs. Consumer creds are NEVER written here: each proxy names two env
# vars, resolved at test time from the SDK repo's gitignored `.env`.
#
# The proxies below are the ones provisioned in `donkey-development-kit-provisioning`
# (see that repo's README "Current proxies" table). Mint a consumer credential
# pair per proxy with the `ddk-request-llm-proxy-access` skill, then export the
# two env vars each entry names.
#
# `base_url` is the proxy ingress WITHOUT a trailing `/v1` (§2 — the ingress is
# verbatim; the OpenAI SDK appends `/responses` itself). Fill it from the real
# host + port 8081 + base path shown for that proxy in the provisioning repo.
# Values here are PLACEHOLDERS — replace every `REPLACE-ME` before running.

[[proxy]]
key = "openai-model-routing"
base_url = "https://REPLACE-ME-shared-omni-gateway-host:8081/REPLACE-ME-base-path"
model = "gpt-5-mini"
client_id_env = "DDK_SANDBOX_OPENAI_ROUTING_CLIENT_ID"
client_secret_env = "DDK_SANDBOX_OPENAI_ROUTING_CLIENT_SECRET"

[[proxy]]
key = "injection-guard"
base_url = "https://REPLACE-ME-shared-omni-gateway-host:8081/REPLACE-ME-base-path"
model = "gpt-5-mini"
client_id_env = "DDK_SANDBOX_INJECTION_GUARD_CLIENT_ID"
client_secret_env = "DDK_SANDBOX_INJECTION_GUARD_CLIENT_SECRET"

