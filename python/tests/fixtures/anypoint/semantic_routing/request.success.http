POST /ddk-semantic-advanced-routing/chat/completions HTTP/1.1
Host: private-space-omni-gateway-qrpud8.wxdmnv.usa-e2.cloudhub.io
Content-Type: application/json
client_id: <redacted>
client_secret: <redacted>

{"model": "any-placeholder", "messages": [{"role": "user", "content": "How do I calculate compound interest?"}]}

