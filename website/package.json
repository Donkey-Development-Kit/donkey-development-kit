{
  "name": "donkey-kit-docs",
  "version": "0.1.0",
  "private": true,
  "description": "Documentation site for the Donkey Development Kit",
  "scripts": {
    "dev": "next dev",
    "generate:llms": "node scripts/generate-llms.mjs",
    "generate:roadmap": "node scripts/generate-roadmap.mjs",
    "prebuild": "npm run generate:roadmap && npm run generate:llms",
    "build": "next build",
    "postbuild": "pagefind --site out --output-subdir _pagefind",
    "preview:pages": "node scripts/preview-pages.mjs",
    "test": "node --test lib/analytics.test.mjs lib/repo.test.mjs",
    "lint": "for f in scripts/*.mjs lib/*.mjs; do node --check \"$f\" || exit 1; done",
    "typecheck": "tsc --noEmit",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "next": "^16.3.8",
    "nextra": "^4.6.1",
    "nextra-theme-docs": "^4.6.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.0.0",
    "pagefind": "^1.5.2",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "zod": "4.3.6",
    "@xmldom/xmldom": "0.9.12"
  },
  "engines": {
    "node": ">=22"
  }
}
